# 复制为 .env 后按你本机账号/端口修改：
#   cp .env.mysql.example .env

# MySQL（先建库：CREATE DATABASE zhifu DEFAULT CHARSET utf8mb4;）
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/zhifu?charset=utf8mb4

# 远程 / Docker Milvus（不要用环境变量名 MILVUS_URI）
VECTOR_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=kb_chunks

JWT_SECRET=zhifu-dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# 本地 Qwen（Ollama / vLLM OpenAI 兼容）；没有模型时保持 true
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_MOCK=true

UPLOAD_DIR=./uploads/docs
CORS_ORIGINS=http://127.0.0.1:18765,http://localhost:18765
