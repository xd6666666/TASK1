# SQLite (default for local demo) or MySQL:
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/zhifu
DATABASE_URL=sqlite:///./data/zhifu.db

# Vector store: milvus-lite file path, or remote Milvus http://127.0.0.1:19530
# NOTE: do not use env name MILVUS_URI (conflicts with pymilvus internals)
VECTOR_URI=./data/milvus.db
MILVUS_COLLECTION=kb_chunks

JWT_SECRET=zhifu-dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Local Qwen via OpenAI-compatible API (vLLM / Ollama)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_MOCK=true

UPLOAD_DIR=./uploads/docs
CORS_ORIGINS=http://127.0.0.1:18765,http://localhost:18765
